# ─────────────────────────────────────────────────────────────────────────────
# SETHAVELLE storefront — environment variables (PLACEHOLDERS ONLY)
#
# Copy to `.env` for local development. `.env` is git-ignored: never commit it.
# On Oxygen, set these in the Hydrogen storefront's environment settings
# (separately for Preview and Production). See docs/ENVIRONMENT.md for what
# each variable does and whether it is ever exposed to the browser.
#
# Exposure legend:
#   [server]  read only inside the worker; never serialized to the browser
#   [public]  safe to appear in the browser (IDs, not credentials)
# ─────────────────────────────────────────────────────────────────────────────

# ── Store connection ─────────────────────────────────────────────────────────
# [public] The store's *.myshopify.com domain. Required in production.
# e.g. your-store.myshopify.com
PUBLIC_STORE_DOMAIN=
# [public] Optional custom checkout domain, e.g. checkout.example.com
PUBLIC_CHECKOUT_DOMAIN=
# [public] Hydrogen storefront ID (numeric). Enables Shopify analytics.
PUBLIC_STOREFRONT_ID=
# [public] Public Storefront API token. Only used if no private token is set.
PUBLIC_STOREFRONT_API_TOKEN=
# [server] Private Storefront API token (preferred). NEVER an Admin token (shpat_).
PRIVATE_STOREFRONT_API_TOKEN=
# Set to 1 to force the tokenless mock.shop demo (no real store, no accounts).
# The demo defaults to the fragrance store arabic-attars.mock.shop; set
# PUBLIC_STORE_DOMAIN to another <store>.mock.shop host to preview a different one.
MOCK_SHOP=

# ── Customer Account API (all three, or none) ────────────────────────────────
# [server] Numeric shop ID.
SHOP_ID=
# [public] Customer Account API client ID (headless channel).
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
# [server] >= 32 random characters. Generate: openssl rand -base64 48
SESSION_SECRET=
# [server] Previous secret, kept only during a rotation window.
SESSION_SECRET_PREVIOUS=

# ── Site ─────────────────────────────────────────────────────────────────────
# [public] Canonical origin for canonical URLs, sitemap, Open Graph.
# e.g. https://www.sethavelle.com
PUBLIC_SITE_URL=
# [server] Collection handle that powers /shop. Defaults to "all".
SHOP_ALL_COLLECTION_HANDLE=all

# ── Marketing (all optional; loaded only after visitor consent) ─────────────
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_TIKTOK_PIXEL_ID=

# ── Form delivery (optional; forms answer 503 until configured) ─────────────
# [server] HTTPS endpoint receiving signed JSON (HMAC-SHA256, X-Sethavelle-Signature)
NEWSLETTER_WEBHOOK_URL=
# [server] >= 32 random characters
NEWSLETTER_WEBHOOK_SECRET=
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
